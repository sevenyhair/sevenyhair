# 설정 순서와 값 받는 곳 → docs/setup-infra.md

# MongoDB Atlas 연결 문자열. DB 이름(seveny)은 코드에 고정돼 있어 URI 에 붙이지 않아도 된다.
MONGODB_URI=

# 운영 도메인 (끝에 / 없이). 비우면 Vercel 운영 주소를 쓴다 — sitemap · 공유 이미지 · canonical
NEXT_PUBLIC_SITE_URL=

# Cloudflare R2 — 이미지 업로드 기능(어드민)을 붙일 때 쓴다. 이름은 Ignite 와 같다.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# 공개 주소 (r2.dev 또는 커스텀 도메인, 끝에 / 없이)
R2_PUBLIC_BASE_URL=
